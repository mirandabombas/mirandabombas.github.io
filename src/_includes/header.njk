{#- On the home page, section links stay on the page instead of reloading it. #}
{%- set home = "" if page.url == "/" else "/" -%}
<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label="{{ site.name }} - página inicial">
      <img src="/images/logo.webp" alt="{{ site.name }}" width="217" height="42">
    </a>
    <nav class="site-nav" aria-label="Principal">
      <a href="{{ home }}#produtos">Produtos</a>
      <a href="{{ home }}#servicos">Serviços</a>
      <a href="{{ home }}#empresa">Empresa</a>
      <a href="{{ home }}#contato">Contato</a>
    </nav>
  </div>
</header>
