<aside class="cta">
  <p>Entre em contato e solicite um orçamento.</p>
  <div class="actions">
    <a class="btn btn-whatsapp" href="{{ site.whatsappUrl }}" target="_blank" rel="noopener">{% icon "whatsapp" %} WhatsApp</a>
    <a class="btn btn-outline" href="tel:{{ site.phones[0].tel }}">{% icon "phone" %} {{ site.phones[0].label }}</a>
    <a class="btn btn-outline" href="mailto:{{ site.email }}">{% icon "mail" %} Fale Conosco</a>
  </div>
</aside>
