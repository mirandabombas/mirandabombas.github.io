<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": {{ site.name | dump | safe }},
    "description": {{ site.description | dump | safe }},
    "url": "{{ site.url }}/",
    "logo": "{{ site.url }}/images/logo.webp",
    "email": {{ site.email | dump | safe }},
    "telephone": [{% for phone in site.phones %}"{{ phone.tel }}"{% if not loop.last %}, {% endif %}{% endfor %}],
    "foundingDate": "{{ site.foundingYear }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": {{ site.address.street | dump | safe }},
      "addressLocality": {{ site.address.city | dump | safe }},
      "addressRegion": {{ site.address.region | dump | safe }},
      "addressCountry": "BR"
    },
    "geo": { "@type": "GeoCoordinates", "latitude": {{ site.geo.latitude }}, "longitude": {{ site.geo.longitude }} }
  }
  </script>
