---
# One page per entry in src/_data/products.js
layout: layouts/page.njk
pagination:
  data: products
  size: 1
  alias: product
permalink: "/produtos/{{ product.slug }}.html"
back:
  url: /#produtos
  label: Produtos
eleventyComputed:
  title: "{{ product.title }}"
  description: "{{ product.summary }}"
  ogImage: "{{ product.ogImage }}"
---
<div class="product-layout">
  {%- set photos = product.photos %}
  {%- if photos.items.length == 1 %}
  <figure class="hero-image">
    <img src="/images/{{ photos.items[0].src }}" alt="{{ photos.alt }}" width="{{ photos.items[0].width }}" height="{{ photos.items[0].height }}">
  </figure>
  {%- else %}
  <div>
    <ul class="gallery" aria-label="Fotos" tabindex="0">
      {%- for photo in photos.items %}
      <li><img src="/images/{{ photo.src }}" alt="{{ photos.alt }} - foto {{ loop.index }}" width="{{ photo.width }}" height="{{ photo.height }}"{% if not loop.first %} loading="lazy"{% endif %}></li>
      {%- endfor %}
    </ul>
    <p class="gallery-hint">Deslize para ver mais fotos ({{ photos.items.length }})</p>
  </div>
  {%- endif %}

  <div>
    <section class="panel">
      <h2>Descrição</h2>
      <p>{{ product.description or product.summary }}</p>
    </section>

    {%- if product.specs %}
    <section class="panel">
      <h2>Detalhes Técnicos</h2>
      <ul class="checklist">
        {%- for item in product.specs %}
        <li>{{ item }}</li>
        {%- endfor %}
      </ul>
    </section>
    {%- endif %}

    {%- if product.warnings %}
    <section class="panel panel-warning">
      <h2>Atenção</h2>
      <ul class="checklist">
        {%- for item in product.warnings %}
        <li>{{ item }}</li>
        {%- endfor %}
      </ul>
    </section>
    {%- endif %}

    {%- if product.install %}
    <section class="panel">
      <h2>Instalação</h2>
      <div class="install-images">
        {%- for image in product.install.items %}
        <a href="/images/{{ image.src }}" target="_blank" rel="noopener"><img src="/images/{{ image.src }}" alt="{{ product.install.alt }}" width="{{ image.width }}" height="{{ image.height }}" loading="lazy"></a>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}
  </div>
</div>
